{
  "name": "onyx-launcher",
  "version": "1.6.3",
  "private": true,
  "description": "A modern desktop launcher for Minecraft instances and modpacks.",
  "author": "Onyx Launcher contributors",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "generate:icon": "electron scripts/generate-icon.cjs",
    "prebuild": "npm run generate:icon",
    "predist": "npm run generate:icon",
    "build:renderer": "tsc --noEmit && vite build",
    "build": "npm run build:renderer && electron-builder --dir",
    "dist": "npm run build:renderer && electron-builder --publish never",
    "dist:linux": "npm run build:renderer && electron-builder --linux AppImage --x64 --publish never",
    "package:linux:tar": "node scripts/package-linux-tar.cjs",
    "dist:linux:archive": "npm run build:renderer && electron-builder --linux dir --x64 --publish never && npm run package:linux:tar",
    "dist:linux:all": "npm run build:renderer && electron-builder --linux AppImage --x64 --publish never && electron-builder --linux dir --x64 --publish never && npm run package:linux:tar",
    "preview": "vite preview",
    "lint": "eslint .",
    "validate": "npm run typecheck && npm run lint && npm test",
    "check": "npm run validate && npm run build:renderer",
    "dist:windows": "npm run build:renderer && electron-builder --win nsis portable --x64 --publish never",
    "capture:screenshots": "npm run build:renderer && node scripts/capture-screenshots.cjs"
  },
  "dependencies": {
    "archiver": "8.0.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "node-stream-zip": "^1.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tar-stream": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "app.onyx.launcher",
    "productName": "Onyx Launcher",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "executableName": "onyx-launcher",
      "artifactName": "Onyx-Launcher-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
